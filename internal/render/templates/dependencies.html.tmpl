{{define "dependencies"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dependency map · {{.Title}}</title>
<link rel="stylesheet" href="{{.Stylesheet}}">
<script>
{{- template "theme-boot"}}

document.addEventListener('DOMContentLoaded', function () {
{{- template "theme-script"}}

	const list = document.getElementById('rank-list');
	if (!list) { return; }
	const rows = Array.from(list.children);
	const graph = new Map();
	const glyphs = document.getElementById('focus-glyphs').content;
	const search = document.getElementById('focus-search');
	const options = document.getElementById('focus-options');
	const board = document.getElementById('focus-graph');
	const edges = document.getElementById('focus-edges');
	const centre = document.getElementById('focus-centre');
	const status = document.getElementById('focus-status');
	const title = document.getElementById('focus-title');
	const count = document.getElementById('rank-count');
	const empty = document.getElementById('rank-empty');
	const toggle = document.getElementById('show-deleted');
	const footnote = document.getElementById('rank-footnote');
	const focusCard = document.getElementById('focus-card');
	const columns = {callers: document.getElementById('focus-callers'), runs: document.getElementById('focus-runs')};
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
	const svg = 'http://www.w3.org/2000/svg';
	const limit = 4;
	let matches = [];
	let active = -1;
	let moveFocus = false;
	let listed = [];

	const plural = function (n, noun) { return n + ' ' + noun + (n === 1 ? '' : 's'); };
	const hashFor = function (key) { return '#map-' + encodeURIComponent(key); };

	function el(tag, className, text) {
		const node = document.createElement(tag);
		if (className) { node.className = className; }
		if (text) { node.textContent = text; }
		return node;
	}

	function glyph(name) {
		return glyphs.querySelector('[data-glyph="' + name + '"]').firstElementChild.cloneNode(true);
	}

	function label(node, plain) {
		const text = el('span', 'focus-text');
		const meta = el('small', '', node.meta);
		if (node.inactive && !plain) {
			const badge = el('span', 'deleted-badge');
			badge.append(glyph('deleted'), document.createTextNode('Deleted'));
			meta.prepend(badge, ' ');
		}
		text.append(el('strong', '', node.name), meta);
		return text;
	}

	function shown(entry) { return toggle.checked || !entry.inactive; }

	for (const row of rows) {
		const link = row.querySelector('.rank-link');
		const node = {
			key: row.dataset.key,
			rank: rows.indexOf(row),
			name: row.querySelector('.rank-text strong').textContent,
			order: Number(row.dataset.order),
			href: link.getAttribute('href'),
			tile: row.querySelector('.shortcut-icon'),
			meta: row.querySelector('.rank-meta').textContent,
			metaText: row.querySelector('.rank-meta'),
			warning: row.querySelector('.rank-warning'),
			reason: row.querySelector('.rank-reason'),
			inactive: row.hasAttribute('data-inactive'),
			row: row,
			link: link,
			callers: [],
			runs: [],
			shownCallers: [],
			shownRuns: [],
			total: 0,
			listed: true,
			self: false
		};
		for (const item of row.querySelectorAll('[data-relation]')) {
			if (item.dataset.kind === 'self') { node.self = true; continue; }
			const name = item.querySelector('.relation-name');
			node[item.dataset.relation].push({key: item.dataset.key || '', kind: item.dataset.kind || 'shortcut', name: name ? name.textContent : '', note: item.dataset.note || '', inactive: item.hasAttribute('data-inactive')});
		}
		graph.set(node.key, node);
		link.href = hashFor(node.key);
		row.removeAttribute('id');
		row.querySelector('.rank-details').remove();
	}
	const nodes = Array.from(graph.values());

	function card(entry) {
		const target = entry.key ? graph.get(entry.key) : null;
		if (target) {
			const link = el('a', 'focus-node' + (target.inactive ? ' inactive' : ''));
			link.href = hashFor(target.key);
			link.append(target.tile.cloneNode(true), label(target));
			return link;
		}
		const box = el('div', 'focus-node ' + entry.kind);
		const icon = el('span', 'focus-glyph');
		icon.append(glyph(entry.kind));
		box.append(icon, label({name: entry.name, meta: entry.note}));
		return box;
	}

	function fill(side, entries) {
		const target = columns[side];
		const column = target.parentElement;
		target.replaceChildren();
		column.classList.remove('expanded');
		entries.forEach(function (entry, index) {
			const item = el('li', index >= limit ? 'focus-more' : '');
			const node = card(entry);
			node.dataset.edge = side + '-' + index;
			if (!entry.key) { node.dataset.kind = entry.kind; } else if (entry.inactive) { node.dataset.kind = 'inactive'; }
			item.append(node);
			target.append(item);
		});
		column.querySelector('.column-count').textContent = entries.length;
		column.querySelector('.column-empty').hidden = entries.length > 0;
		const more = column.querySelector('.focus-expand');
		more.hidden = entries.length <= limit;
		more.textContent = 'Show ' + (entries.length - limit) + ' more';
		board.classList.toggle('has-' + side, entries.length > 0);
	}

	function edge(className, points, arrow, key) {
		const path = document.createElementNS(svg, 'path');
		const sx = points[0], sy = points[1], ex = points[2], ey = points[3];
		const bend = Math.max(8, (ex - sx) / 2);
		path.setAttribute('class', className);
		path.setAttribute('d', 'M' + sx + ' ' + sy + ' C' + (sx + bend) + ' ' + sy + ' ' + (ex - bend) + ' ' + ey + ' ' + ex + ' ' + ey);
		if (arrow) { path.setAttribute('marker-end', 'url(#focus-arrow)'); }
		if (key) { path.dataset.edge = key; }
		edges.append(path);
	}

	function drawEdges() {
		for (const path of edges.querySelectorAll('.edge')) { path.remove(); }
		const main = document.getElementById('focus-current');
		if (!main || getComputedStyle(edges).display === 'none') { return; }
		const box = board.getBoundingClientRect();
		const focus = main.getBoundingClientRect();
		const mid = focus.top - box.top + focus.height / 2;
		const left = focus.left - box.left;
		const right = focus.right - box.left;
		edges.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
		for (const side of ['callers', 'runs']) {
			const visible = Array.from(columns[side].querySelectorAll('.focus-node')).filter(function (node) { return node.offsetParent !== null; });
			if (!visible.length) { continue; }
			const incoming = side === 'callers';
			const junction = incoming ? left - 22 : right + 22;
			for (const node of visible) {
				const r = node.getBoundingClientRect();
				const middle = r.top - box.top + r.height / 2;
				const className = 'edge' + (node.dataset.kind ? ' ' + node.dataset.kind : '');
				if (incoming) {
					edge(className, [r.right - box.left, middle, junction, mid], false, node.dataset.edge);
				} else {
					edge(className, [junction, mid, r.left - box.left - 3, middle], true, node.dataset.edge);
				}
			}
			if (incoming) {
				edge('edge trunk', [junction, mid, left - 3, mid], true, '');
			} else {
				edge('edge trunk', [right, mid, junction, mid], false, '');
			}
		}
	}

	function light(event) {
		const node = event.type === 'pointerleave' ? null : event.target.closest('[data-edge]');
		for (const path of edges.querySelectorAll('.edge')) {
			path.classList.toggle('lit', !!node && path.dataset.edge === node.dataset.edge);
		}
	}

	function focusOn(node) {
		centre.replaceChildren();
		const main = el('a', 'focus-node focus-current' + (node.inactive ? ' inactive' : ''));
		main.id = 'focus-current';
		main.href = node.href;
		const open = el('span', 'focus-open', 'Open shortcut');
		open.append(glyph('chevron'));
		main.append(node.tile.cloneNode(true), label(node, true), open);
		centre.append(main);
		const badges = el('div', 'focus-badges');
		if (node.self) {
			const badge = el('span', 'focus-badge');
			badge.append(glyph('repeat'), document.createTextNode('Runs itself'));
			badges.append(badge);
		}
		if (node.reason) {
			const badge = el('span', 'focus-badge deleted');
			badge.append(glyph('deleted'), document.createTextNode('Deleted: ' + node.reason.textContent));
			badges.append(badge);
		}
		if (node.warning) {
			const badge = node.warning.cloneNode(true);
			badge.className = 'focus-badge warning';
			badges.append(badge);
		}
		if (badges.childElementCount) { centre.append(badges); }
		fill('callers', node.shownCallers);
		fill('runs', node.shownRuns);
		for (const other of nodes) {
			const current = other === node;
			other.row.classList.toggle('current', current);
			if (current) { other.link.setAttribute('aria-current', 'true'); } else { other.link.removeAttribute('aria-current'); }
		}
		title.textContent = 'Connections of ' + node.name;
		status.textContent = node.name + ': ' + (node.inactive ? 'deleted, ' : '') + node.meta;
		drawEdges();
	}

	function keyFromHash() {
		if (window.location.hash.indexOf('#map-') !== 0) { return ''; }
		try { return decodeURIComponent(window.location.hash.slice(5)); } catch (error) { return ''; }
	}

	function reveal(element) {
		const r = element.getBoundingClientRect();
		if (r.top < 0 || r.bottom > window.innerHeight) {
			element.scrollIntoView({block: 'center', behavior: reduced.matches ? 'auto' : 'smooth'});
		}
	}

	function fromHash() {
		const moved = moveFocus;
		moveFocus = false;
		const wanted = graph.get(keyFromHash());
		if (wanted && !wanted.listed && !toggle.checked) {
			toggle.checked = true;
			scope();
		}
		const node = wanted && wanted.listed ? wanted : listed[0];
		if (!node) { return; }
		focusOn(node);
		if (moved) {
			const main = document.getElementById('focus-current');
			main.focus({preventScroll: true});
			reveal(main);
		}
	}

	function choose(key) {
		search.value = '';
		filter();
		if (window.location.hash === hashFor(key)) { fromHash(); } else { window.location.hash = hashFor(key); }
	}

	function renderOptions() {
		options.replaceChildren();
		matches.forEach(function (node, index) {
			const option = el('li', 'focus-option');
			option.id = 'focus-option-' + index;
			option.dataset.key = node.key;
			option.setAttribute('role', 'option');
			option.setAttribute('aria-selected', index === active ? 'true' : 'false');
			option.append(node.tile.cloneNode(true), label(node));
			options.append(option);
		});
		const open = matches.length > 0;
		options.hidden = !open;
		search.setAttribute('aria-expanded', open ? 'true' : 'false');
		if (open && active >= 0) { search.setAttribute('aria-activedescendant', 'focus-option-' + active); } else { search.removeAttribute('aria-activedescendant'); }
	}

	function scope() {
		for (const node of nodes) {
			node.shownCallers = node.callers.filter(shown);
			node.shownRuns = node.runs.filter(shown);
			node.meta = plural(node.shownCallers.length, 'caller') + ' · ' + plural(node.shownRuns.length, 'run') + (node.self ? ' · runs itself' : '');
			node.metaText.textContent = node.meta;
			node.total = node.shownCallers.length + node.shownRuns.length;
			node.listed = shown(node) && (node.total > 0 || node.self);
		}
		listed = nodes.filter(function (node) { return node.listed; }).sort(function (a, b) { return b.total - a.total || a.order - b.order; });
		listed.forEach(function (node, index) {
			node.rank = index;
			list.append(node.row);
		});
		for (const node of nodes) {
			if (!node.listed) { list.append(node.row); }
		}
		focusCard.hidden = listed.length === 0;
		if (footnote) {
			const standalone = Number(toggle.checked ? footnote.dataset.all : footnote.dataset.active);
			footnote.hidden = standalone === 0;
			footnote.querySelector('.footnote-text').textContent = standalone === 1 ? '1 standalone shortcut neither runs nor is run by another, so it is not listed.' : standalone + ' standalone shortcuts neither run nor are run by another, so they are not listed.';
		}
		filter();
	}

	function storeDeleted() {
		try {
			if (toggle.checked) { localStorage.setItem('sss-show-deleted', '1'); } else { localStorage.removeItem('sss-show-deleted'); }
		} catch (error) {}
	}

	function filter() {
		const query = search.value.trim().toLowerCase();
		const hits = listed.filter(function (node) { return node.name.toLowerCase().includes(query); });
		for (const node of nodes) { node.row.hidden = !hits.includes(node); }
		count.textContent = query ? hits.length + ' of ' + plural(listed.length, 'shortcut') : plural(listed.length, 'shortcut');
		empty.hidden = hits.length > 0;
		const starts = function (node) { return node.name.toLowerCase().startsWith(query) ? 0 : 1; };
		matches = query && document.activeElement === search ? hits.slice().sort(function (a, b) { return starts(a) - starts(b) || a.rank - b.rank; }).slice(0, 8) : [];
		active = matches.length ? 0 : -1;
		renderOptions();
	}

	search.addEventListener('input', filter);
	search.addEventListener('focus', filter);
	search.addEventListener('blur', function () { matches = []; renderOptions(); });
	search.addEventListener('keydown', function (event) {
		if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
			if (!matches.length) { return; }
			event.preventDefault();
			active = (active + (event.key === 'ArrowDown' ? 1 : -1) + matches.length) % matches.length;
			renderOptions();
			options.children[active].scrollIntoView({block: 'nearest'});
		} else if (event.key === 'Enter') {
			if (!matches.length) { return; }
			event.preventDefault();
			choose(matches[Math.max(active, 0)].key);
		} else if (event.key === 'Escape') {
			if (matches.length) {
				event.preventDefault();
				matches = [];
				renderOptions();
			} else if (search.value) {
				event.preventDefault();
				search.value = '';
				filter();
			}
		}
	});
	options.addEventListener('mousedown', function (event) { event.preventDefault(); });
	options.addEventListener('click', function (event) {
		const option = event.target.closest('[data-key]');
		if (option) { choose(option.dataset.key); }
	});
	document.addEventListener('keydown', function (event) {
		const typing = ['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName);
		if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey) {
			event.preventDefault();
			search.focus();
		}
	});
	document.addEventListener('click', function (event) {
		const link = event.target.closest('a[href^="#map-"]');
		if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) { return; }
		moveFocus = true;
		if (link.getAttribute('href') === window.location.hash) {
			event.preventDefault();
			fromHash();
		}
	});
	for (const button of document.getElementsByClassName('focus-expand')) {
		button.addEventListener('click', function () {
			button.parentElement.classList.add('expanded');
			button.hidden = true;
			drawEdges();
		});
	}
	toggle.addEventListener('change', function () {
		storeDeleted();
		scope();
		const current = graph.get(keyFromHash());
		if (current && !current.listed) { history.replaceState(null, '', window.location.pathname + window.location.search); }
		fromHash();
	});
	board.addEventListener('pointerover', light);
	board.addEventListener('pointerleave', light);
	board.addEventListener('focusin', light);
	window.addEventListener('hashchange', fromHash);
	new ResizeObserver(drawEdges).observe(board);
	try { toggle.checked = localStorage.getItem('sss-show-deleted') === '1'; } catch (error) {}
	document.getElementById('focus-tools').hidden = false;
	list.classList.add('interactive');
	scope();
	fromHash();
});
</script>
</head>
<body>
{{template "topbar" .Chrome}}
<main>
<div class="page-heading map-heading"><h1>Dependency map</h1></div>
<div class="map-summary"><span>{{.Connected}} connected</span><span>{{.Standalone}} standalone</span>{{if .Missing}}<span>{{.Missing}} missing reference{{if ne .Missing 1}}s{{end}}</span>{{end}}{{if .Dynamic}}<span>{{.Dynamic}} chosen at run time</span>{{end}}{{if .Deleted}}<a class="inline-link" href="{{.Home}}#deleted">{{.Deleted}} deleted shortcut{{if ne .Deleted 1}}s{{end}}</a>{{end}}</div>
{{- if .Rows}}
<div class="focus-tools" id="focus-tools" hidden>
<div class="focus-search">
<label class="search">{{template "icon-search"}}<span class="sr-only">Find a connected shortcut</span><input id="focus-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="focus-options" placeholder="Find a connected shortcut" autocomplete="off" spellcheck="false"><kbd aria-hidden="true">/</kbd></label>
<ul class="focus-options" id="focus-options" role="listbox" aria-label="Matching shortcuts" hidden></ul>
</div>
<label class="toggle"{{if not .Deleted}} hidden{{end}}><input type="checkbox" id="show-deleted" autocomplete="off"><span>Show deleted shortcuts</span><span class="toggle-count">{{.Deleted}}</span></label>
<div class="graph-legend" aria-hidden="true"><span><i class="legend-line"></i>Runs</span><span><i class="legend-line missing"></i>Missing</span><span><i class="legend-line dynamic"></i>Chosen at run time</span></div>
</div>
<section class="focus-card" id="focus-card" aria-labelledby="focus-title" hidden>
<h2 class="sr-only" id="focus-title">Connections</h2>
<div class="focus-graph" id="focus-graph">
<svg class="focus-edges" id="focus-edges" aria-hidden="true" focusable="false"><defs><marker id="focus-arrow" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10z" fill="context-stroke"></path></marker></defs></svg>
<div class="focus-column focus-callers"><h3>Called by <span class="column-count"></span></h3><ul id="focus-callers"></ul><p class="column-empty">Nothing in this backup runs it</p><button type="button" class="btn focus-expand" hidden></button></div>
<div class="focus-arrow focus-arrow-in" aria-hidden="true">{{template "icon-arrow-down"}}</div>
<div class="focus-centre" id="focus-centre"></div>
<div class="focus-arrow focus-arrow-out" aria-hidden="true">{{template "icon-arrow-down"}}</div>
<div class="focus-column focus-runs"><h3>Runs <span class="column-count"></span></h3><ul id="focus-runs"></ul><p class="column-empty">Runs no other shortcut</p><button type="button" class="btn focus-expand" hidden></button></div>
</div>
</section>
<p class="sr-only" id="focus-status" role="status" aria-live="polite"></p>
<template id="focus-glyphs"><span data-glyph="missing">{{template "icon-warning"}}</span><span data-glyph="dynamic">{{template "icon-shuffle"}}</span><span data-glyph="repeat">{{template "icon-repeat"}}</span><span data-glyph="chevron">{{template "icon-chevron"}}</span><span data-glyph="deleted">{{template "icon-trash"}}</span></template>
<section class="rank-section" aria-labelledby="rank-heading">
<div class="section-heading rank-heading"><h2 id="rank-heading">Most connected</h2><span id="rank-count" role="status" aria-live="polite">{{len .Rows}} shortcut{{if ne (len .Rows) 1}}s{{end}}</span></div>
<p class="rank-intro">Ranked by how many shortcuts run each one plus how many it runs{{if .Deleted}}, counting deleted shortcuts only while they are shown{{end}}.</p>
<ol class="rank-list" id="rank-list">
{{- range .Rows}}
<li class="rank-row{{if .Inactive}} inactive{{end}}" id="{{.Anchor}}" data-key="{{.Key}}" data-order="{{.NameOrder}}"{{if .Inactive}} data-inactive{{end}}>
<a class="rank-link" href="{{.Href}}"><span class="shortcut-icon{{if .DarkIcon}} dark-icon{{end}}" style="--icon: {{.Color}}">{{template "icon-layers"}}</span><span class="rank-text"><strong>{{.Name}}</strong>{{with .Inactive}}<small class="rank-status"><span class="deleted-badge">{{template "icon-trash"}} Deleted</span> <span class="rank-reason">{{.}}</span></small>{{end}}<small class="rank-meta">{{.CallerCount}} caller{{if ne .CallerCount 1}}s{{end}} · {{.RunCount}} run{{if ne .RunCount 1}}s{{end}}{{if .Self}} · runs itself{{end}}</small>{{if .Missing}}<small class="rank-warning">{{template "icon-warning"}} {{.Missing}} missing reference{{if ne .Missing 1}}s{{end}}</small>{{end}}</span></a>
<details class="rank-details"><summary>Callers and runs</summary>
<div class="rank-relations">
<div><h3>Called by</h3>{{if .Callers}}<ul>{{range .Callers}}<li data-relation="callers" data-key="{{.Key}}"{{if .Inactive}} data-inactive{{end}}><a href="{{.Href}}">{{.Name}}</a>{{if .Inactive}} <small class="relation-deleted">Deleted</small>{{end}}</li>{{end}}</ul>{{else}}<p>Nothing in this backup runs it.</p>{{end}}</div>
<div><h3>Runs</h3>{{if or .Runs .Self}}<ul>
{{- range .Runs}}
{{- if eq .Kind "shortcut"}}<li data-relation="runs" data-key="{{.Key}}"{{if .Inactive}} data-inactive{{end}}><a href="{{.Href}}">{{.Name}}</a>{{if .Inactive}} <small class="relation-deleted">Deleted</small>{{end}}</li>
{{- else}}<li class="relation-{{.Kind}}" data-relation="runs" data-kind="{{.Kind}}" data-note="{{.Note}}"><span class="relation-name">{{.Name}}</span> <small>{{.Note}}</small></li>
{{- end}}
{{- end}}
{{- if .Self}}<li data-relation="runs" data-kind="self">Itself</li>{{end -}}
</ul>{{else}}<p>No other shortcut.</p>{{end}}</div>
</div>
</details>
</li>
{{- end}}
</ol>
<div class="empty" id="rank-empty" hidden><h2>No connected shortcut matches</h2><p>Only shortcuts that run or are run by another are listed here{{if .Deleted}}; deleted shortcuts are listed only while shown{{end}}.</p></div>
{{- if or .Standalone .StandaloneAll}}
<p class="rank-footnote" id="rank-footnote" data-active="{{.Standalone}}" data-all="{{.StandaloneAll}}"{{if not .StandaloneAll}} hidden{{end}}><span class="footnote-text">{{if eq .StandaloneAll 1}}1 standalone shortcut neither runs nor is run by another, so it is not listed.{{else}}{{.StandaloneAll}} standalone shortcuts neither run nor are run by another, so they are not listed.{{end}}</span> <a class="text-link" href="{{.Home}}#standalone">Browse standalone shortcuts</a></p>
{{- end}}
</section>
{{- else}}
<div class="empty"><h2>No connections yet</h2><p>No shortcut in this backup runs another.</p></div>
{{- end}}
</main>
</body>
</html>
{{end}}
