{{define "review"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone=no,date=no">
<title>{{.Title}}</title>
{{if .Stylesheet}}<link rel="stylesheet" href="{{.Stylesheet}}">{{else}}<style>
{{.InlineCSS}}</style>{{end}}
<script>
{{- template "theme-boot"}}

document.addEventListener('DOMContentLoaded', function () {
{{template "drawer-script"}}

	for (const button of document.getElementsByClassName('button')) {
		button.addEventListener('click', function () {
			this.classList.toggle('closed');
			const content = this.nextElementSibling;
			content.style.display = getComputedStyle(content).display === 'none' ? 'block' : 'none';
		});
	}

	for (const link of document.getElementsByClassName('magic')) {
		link.addEventListener('click', function (event) {
			event.stopPropagation();
			follow(this, event);
		});
		link.addEventListener('keydown', function (event) {
			if (event.key !== 'Enter' && event.key !== ' ') { return; }
			event.preventDefault();
			event.stopPropagation();
			follow(this, event);
		});
		link.addEventListener('keyup', function (event) {
			if (event.key === ' ') { event.preventDefault(); }
		});
	}

	function follow(link, event) {
		if (!link.dataset.href) { reveal(link.dataset.target); return; }
		if (event.metaKey || event.ctrlKey) { window.open(link.dataset.href); } else { window.location.href = link.dataset.href; }
	}

	function reveal(index) {
		const target = document.getElementById('m' + index);
		if (!target) { return; }
		let content = target.parentElement.closest('.content');
		while (content) {
			content.style.display = 'block';
			content.previousElementSibling.classList.remove('closed');
			content = content.parentElement.closest('.content');
		}
		setTimeout(function () {
			target.focus({preventScroll: true});
			target.scrollIntoView({block: 'center', behavior: 'smooth'});
			target.classList.add('flash');
			setTimeout(function () { target.classList.remove('flash'); }, 1600);
		}, 10);
	}
{{template "theme-script"}}
});
</script>
</head>
<body>
{{template "topbar" .Chrome}}
<main class="review-main">
{{template "header" .Header}}
<div class="detail-grid">
<section class="actions" aria-labelledby="actions-heading">
<div class="section-heading"><h2 id="actions-heading">Actions</h2><span>In execution order</span></div>
{{- with .Header}}{{if .Corrupted}}
<p class="notice">{{template "icon-warning"}}<span>This shortcut is <span class="magic flagged" data-target="{{.CorruptedAt}}" role="link" tabindex="0">corrupted at action {{.CorruptedAt}}</span>. The flagged rows under Details say why.</span></p>
{{- end}}{{end}}
{{- template "items" .Items}}
</section>
</div>
</main>
<dialog class="details-drawer" id="details-drawer" aria-labelledby="details-heading" open>{{template "details" .Header}}</dialog>
</body>
</html>
{{end}}
