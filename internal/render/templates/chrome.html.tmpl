{{define "theme-boot"}}
try {
	const saved = localStorage.getItem('sss-theme');
	if (saved === 'dark' || saved === 'light') { document.documentElement.dataset.theme = saved; }
} catch (error) {}
{{- end}}

{{define "topbar"}}
<header class="topbar">
{{- if .Home}}
<a class="brand" href="{{.Home}}"><span class="brand-mark">{{template "icon-layers"}}</span><span>{{.SiteTitle}}</span></a>
{{- else}}
<span class="brand"><span class="brand-mark">{{template "icon-layers"}}</span><span>{{.SiteTitle}}</span></span>
{{- end}}
<div class="topbar-actions">
{{- with .MapHref}}
<a class="topbar-link" href="{{.}}"{{if $.OnMap}} aria-current="page"{{end}}>{{template "icon-graph"}}<span>Dependency map</span></a>
{{- end}}
<button type="button" class="icon-button" id="theme" title="Appearance: automatic" aria-label="Appearance: automatic">{{template "icon-theme"}}</button>
</div>
</header>
{{- end}}

{{define "theme-script"}}
	const themeButton = document.getElementById('theme');
	const themeNames = {auto: 'automatic', dark: 'dark', light: 'light'};
	const nextTheme = {auto: 'dark', dark: 'light', light: 'auto'};
	const currentTheme = function () { return document.documentElement.dataset.theme || 'auto'; };
	const labelTheme = function () {
		const text = 'Appearance: ' + themeNames[currentTheme()];
		themeButton.title = text;
		themeButton.setAttribute('aria-label', text);
	};
	themeButton.addEventListener('click', function () {
		const next = nextTheme[currentTheme()];
		try {
			if (next === 'auto') { localStorage.removeItem('sss-theme'); } else { localStorage.setItem('sss-theme', next); }
		} catch (error) {}
		if (next === 'auto') { delete document.documentElement.dataset.theme; } else { document.documentElement.dataset.theme = next; }
		labelTheme();
	});
	labelTheme();
{{- end}}
