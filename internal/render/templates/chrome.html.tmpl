{{define "theme-boot"}}
try {
	const saved = localStorage.getItem('sss-theme');
	if (saved === 'dark' || saved === 'light') { document.documentElement.dataset.theme = saved; }
} catch (error) {}
{{- end}}

{{define "topbar"}}
<header class="topbar{{if .Home}} has-navigation{{end}}">
{{- if .Home}}
<a class="brand" href="{{.Home}}" aria-label="{{.SiteTitle}}" title="{{.SiteTitle}}"><span class="brand-mark">{{template "icon-layers"}}</span></a>
{{- else}}
<span class="brand" aria-label="{{.SiteTitle}}"><span class="brand-mark">{{template "icon-layers"}}</span></span>
{{- end}}
<div class="topbar-actions">
{{if .Home}}<nav class="site-navigation" aria-label="Main navigation">
<a class="topbar-link library-link" href="{{.Home}}"{{if not .OnMap}} aria-current="{{if .OnIndex}}page{{else}}location{{end}}"{{end}}>{{template "icon-layers"}}<span>All shortcuts</span></a>{{end}}
{{if .OnDetail}}<button type="button" class="icon-button details-toggle" id="details-toggle" aria-label="Show details" title="Show details" aria-controls="details-drawer" aria-expanded="false" hidden>{{template "icon-panel"}}</button>{{end}}
{{- with .MapHref}}
<a class="topbar-link" href="{{.}}"{{if $.OnMap}} aria-current="page"{{end}}>{{template "icon-graph"}}<span>Dependency map</span></a>
{{- end}}
{{if .Home}}</nav>{{end}}

</div>
</header>
{{- end}}

{{define "site-footer"}}
<footer class="site-footer">
<a class="copyright" href="https://andrewm.codes">© Andrew Mason</a>
<div class="appearance-control" role="group" aria-label="Appearance">
<button type="button" data-appearance="auto" aria-label="System appearance" title="System appearance" aria-pressed="true">{{template "icon-system"}}</button>
<button type="button" data-appearance="light" aria-label="Light appearance" title="Light appearance" aria-pressed="false">{{template "icon-theme"}}</button>
<button type="button" data-appearance="dark" aria-label="Dark appearance" title="Dark appearance" aria-pressed="false">{{template "icon-moon"}}</button>
</div>
</footer>
{{end}}

{{define "theme-script"}}
	const appearanceButtons = document.querySelectorAll('[data-appearance]');
	function labelAppearance() {
		const current = document.documentElement.dataset.theme || 'auto';
		for (const button of appearanceButtons) {
			button.setAttribute('aria-pressed', String(button.dataset.appearance === current));
		}
	}
	for (const button of appearanceButtons) {
		button.addEventListener('click', function () {
			const next = button.dataset.appearance;
			try {
				if (next === 'auto') { localStorage.removeItem('sss-theme'); } else { localStorage.setItem('sss-theme', next); }
			} catch (error) {}
			if (next === 'auto') { delete document.documentElement.dataset.theme; } else { document.documentElement.dataset.theme = next; }
			labelAppearance();
		});
	}
	labelAppearance();
{{- end}}
