{{define "icon-search"}}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="10" r="6"></circle><path d="m15 15 5 5"></path></svg>{{end}}

{{define "icon-back"}}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"></path></svg>{{end}}

{{define "icon-warning"}}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 10 18H2L12 3Zm0 6v5m0 3v1"></path></svg>{{end}}

{{define "icon-theme"}}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"></path></svg>{{end}}

{{define "theme-boot"}}
try {
	const saved = localStorage.getItem('sss-theme');
	if (saved === 'dark' || saved === 'light') { document.documentElement.dataset.theme = saved; }
} catch (error) {}
{{- end}}

{{define "topbar"}}
<header class="topbar">
{{- if .Home}}
<a class="brand" href="{{.Home}}"><span class="brand-mark">{{template "icon-layers"}}</span><span>{{.SiteTitle}}</span></a>
{{- else}}
<span class="brand"><span class="brand-mark">{{template "icon-layers"}}</span><span>{{.SiteTitle}}</span></span>
{{- end}}
<button type="button" class="icon-button" id="theme" title="Appearance: automatic" aria-label="Appearance: automatic">{{template "icon-theme"}}</button>
</header>
{{- end}}

{{define "theme-script"}}
	const themeButton = document.getElementById('theme');
	const themeNames = {auto: 'automatic', dark: 'dark', light: 'light'};
	const nextTheme = {auto: 'dark', dark: 'light', light: 'auto'};
	const currentTheme = function () { return document.documentElement.dataset.theme || 'auto'; };
	const labelTheme = function () {
		const text = 'Appearance: ' + themeNames[currentTheme()];
		themeButton.title = text;
		themeButton.setAttribute('aria-label', text);
	};
	themeButton.addEventListener('click', function () {
		const next = nextTheme[currentTheme()];
		try {
			if (next === 'auto') { localStorage.removeItem('sss-theme'); } else { localStorage.setItem('sss-theme', next); }
		} catch (error) {}
		if (next === 'auto') { delete document.documentElement.dataset.theme; } else { document.documentElement.dataset.theme = next; }
		labelTheme();
	});
	labelTheme();
{{- end}}
