{{define "nodes"}}{{range .}}{{template "node" .}}{{end}}{{end}}

{{define "node"}}
{{- if eq .Kind "text"}}{{.Text}}
{{- else if eq .Kind "escape"}}<b>{{.Text}}</b>
{{- else if eq .Kind "break"}}<br>
{{- else if eq .Kind "box"}}<span class="box">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "var"}}<span class="var">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "magic"}}<span class="magic" data-target="{{.Target}}" role="link" tabindex="0">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "page"}}<span class="magic page-link" data-href="{{.Text}}" role="link" tabindex="0">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "missing"}}<span class="missing-ref">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "flag"}}<span class="flagged">{{template "nodes" .Children}}</span>
{{- else if eq .Kind "bold"}}<b>{{template "nodes" .Children}}</b>
{{- else if eq .Kind "italic"}}<i>{{template "nodes" .Children}}</i>
{{- end}}
{{- end}}

{{define "row"}}
{{- if .Full}}
<div class="col2">{{template "nodes" .Value}}</div>
{{- else}}
<div class="row"><div class="col1">{{.Label}}</div><div class="col2">{{template "nodes" .Value}}</div></div>
{{- end}}
{{- end}}

{{define "items"}}
{{- range .}}
{{- template "item" .}}
{{- end}}
{{- end}}

{{define "item"}}
<button class="{{.ButtonClass}}" id="m{{.Index}}"><span class="step">{{.Index}}</span>{{template "nodes" .Label}}</button>
{{- if .Container}}<div class="{{.ContentClass}}"{{if .Collapsed}} style="display:none"{{end}}>
{{- range .Rows}}{{template "row" .}}{{end}}
{{- template "items" .Children}}
</div>
{{- end}}
{{- end}}

{{define "header"}}
<div class="detail-heading{{if .Inactive}} inactive{{end}}"><span class="shortcut-icon{{if .DarkIcon}} dark-icon{{end}}" style="--icon: {{.Color}}">{{template "icon-layers"}}</span><div><h1>{{.Name}}</h1>
<div class="detail-meta"><span>{{.ActionCount}} action{{if ne .ActionCount 1}}s{{end}}</span>{{with .MinimumOS}}<span>iOS {{.}}</span>{{end}}{{with .Modified}}<span>Modified {{.}}</span>{{end}}{{if .Corrupted}}<span class="flagged">Flagged</span>{{end}}{{if .Inactive}}<span><span class="deleted-badge">{{template "icon-trash"}} Deleted</span></span>{{end}}</div></div></div>
{{- with .Inactive}}
<div class="status-banner" role="note">{{template "icon-trash"}}<p><strong>Deleted.</strong> {{if .Conflict}}This is a sync-conflict copy{{with .OriginalName}} of {{if $.Inactive.OriginalHref}}<a class="text-link" href="{{$.Inactive.OriginalHref}}">{{.}}</a>{{else}}<b>{{.}}</b>{{end}}{{end}}. The Shortcuts app hides conflict copies, so it is not in your library, but the backup keeps it in case it holds work the original lost.{{else}}This shortcut is no longer in your Shortcuts library. The backup keeps its last version so you can still find and reinstall it.{{end}}</p></div>
{{- end}}
{{- end}}

{{define "relation"}}
<div class="related related-{{.Kind}}{{if .Inactive}} inactive{{end}}">
{{- if .Href}}<a href="{{.Href}}"><span class="shortcut-icon{{if .DarkIcon}} dark-icon{{end}}" style="--icon: {{.Color}}">{{template "icon-layers"}}</span><span><strong>{{.Name}}</strong>{{with .Inactive}}<small class="related-status">{{.}}</small>{{end}}{{with .Note}}<small>{{.}}</small>{{end}}{{with .Detail}}<small>{{.}}</small>{{end}}</span>{{template "icon-chevron"}}</a>
{{- else}}<div><span class="related-glyph">{{if eq .Kind "missing"}}{{template "icon-warning"}}{{else if eq .Kind "self"}}{{template "icon-repeat"}}{{else}}{{template "icon-link"}}{{end}}</span><span><strong>{{.Name}}</strong>{{with .Note}}<small>{{.}}</small>{{end}}{{with .Detail}}<code>{{.}}</code>{{end}}</span></div>
{{- end}}
{{- with .Actions}}<p class="related-steps">Action{{if gt (len .) 1}}s{{end}}{{range .}} <span class="magic" data-target="{{.}}" role="link" tabindex="0">{{.}}</span>{{end}}</p>{{end}}
</div>
{{- end}}

{{define "details"}}
<aside class="detail-side" aria-labelledby="details-heading">
<div class="meta-panel" id="details">
<div class="drawer-heading"><h2 id="details-heading">Details</h2><button class="icon-button" id="details-close" type="button" aria-label="Close details" title="Close details" hidden>{{template "icon-close"}}</button></div>

{{- with .Deps}}
<section class="relations" aria-labelledby="runs-heading">
<h3 id="runs-heading">Runs{{with .Runs}} <span>{{len .}}</span>{{end}}</h3>
{{- range .Runs}}{{template "relation" .}}{{else}}
<p class="relations-empty">{{if .RunsDeleted}}Runs only deleted shortcuts.{{else}}No Run Shortcut actions.{{end}}</p>
{{- end}}
</section>
{{- with .RunsDeleted}}
<section class="relations relations-deleted" aria-labelledby="runs-deleted-heading">
<h3 id="runs-deleted-heading">Runs (Deleted) <span>{{len .}}</span></h3>
{{- range .}}{{template "relation" .}}{{end}}
</section>
{{- end}}
<section class="relations" aria-labelledby="callers-heading">
<h3 id="callers-heading">Called by{{with .CalledBy}} <span>{{len .}}</span>{{end}}</h3>
{{- range .CalledBy}}{{template "relation" .}}{{else}}
<p class="relations-empty">{{if .CalledByDeleted}}Only deleted shortcuts run it.{{else}}Nothing in this backup runs it.{{end}}</p>
{{- end}}
</section>
{{- with .CalledByDeleted}}
<section class="relations relations-deleted" aria-labelledby="callers-deleted-heading">
<h3 id="callers-deleted-heading">Called by (Deleted) <span>{{len .}}</span></h3>
{{- range .}}{{template "relation" .}}{{end}}
</section>
{{- end}}
<a class="btn map-button" href="{{.MapHref}}">{{template "icon-graph"}} Open dependency map</a>
{{- end}}
<details class="technical-details">
<summary>Shortcut information</summary>
<dl class="meta-list">
<div><dt>Colour</dt><dd><span class="swatch" style="background-color: {{.Color}}"></span> {{.ColorText}}</dd></div>
{{- range .Rows}}
{{- if .Nodes}}
<div><dt>{{.Label}}</dt><dd>{{template "nodes" .Nodes}}</dd></div>
{{- else if .Text}}
<div{{if .Flagged}} class="flagged-row"{{end}}><dt>{{.Label}}</dt><dd>{{.Text}}</dd></div>
{{- end}}
{{- end}}
</dl>
</details>
</div>
</aside>
{{- end}}
