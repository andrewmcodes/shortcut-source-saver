{{define "index"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="{{.Stylesheet}}">
<script>
{{- template "theme-boot"}}

document.addEventListener('DOMContentLoaded', function () {
	const list = document.getElementById('shortcuts');
	const cards = Array.from(list.children);
	const search = document.getElementById('search');
	const filter = document.getElementById('filter');
	const sort = document.getElementById('sort');
	const empty = document.getElementById('empty');
	const title = document.getElementById('results-title');
	const count = document.getElementById('results-count');
	const name = function (card) { return card.querySelector('h3').textContent; };
	const plural = function (n) { return n + (n === 1 ? ' shortcut' : ' shortcuts'); };
	const orders = {
		name: function (a, b) { return cards.indexOf(a) - cards.indexOf(b); },
		actions: function (a, b) { return Number(b.dataset.actions) - Number(a.dataset.actions); },
		modified: function (a, b) { return b.dataset.modified.localeCompare(a.dataset.modified); }
	};

	function update() {
		const query = search.value.trim().toLowerCase();
		const flaggedOnly = filter.value === 'flagged';
		let pool = 0;
		let shown = 0;
		for (const card of cards) {
			const inFilter = !flaggedOnly || card.hasAttribute('data-flagged');
			const visible = inFilter && name(card).toLowerCase().includes(query);
			if (inFilter) { pool++; }
			if (visible) { shown++; }
			card.hidden = !visible;
		}
		title.textContent = filter.selectedOptions[0].dataset.label;
		count.textContent = query ? shown + ' of ' + plural(pool) : plural(shown);
		empty.hidden = shown > 0;
		list.hidden = shown === 0;
	}

	function reorder() {
		const sorted = cards.slice().sort(function (a, b) { return orders[sort.value](a, b) || orders.name(a, b); });
		for (const card of sorted) { list.appendChild(card); }
	}

	search.addEventListener('input', update);
	filter.addEventListener('change', update);
	sort.addEventListener('change', reorder);
	document.getElementById('clear').addEventListener('click', function () {
		search.value = '';
		filter.value = 'all';
		update();
		search.focus();
	});
	document.addEventListener('keydown', function (event) {
		const typing = ['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName);
		if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey) {
			event.preventDefault();
			search.focus();
		}
	});
	window.addEventListener('pageshow', function () { reorder(); update(); });
	document.getElementById('toolbar').hidden = false;
{{template "theme-script"}}
});
</script>
</head>
<body>
{{template "topbar" .Chrome}}
<main>
<div class="page-heading"><h1>{{.Title}}</h1>{{with .LastModified}}<span class="badge">Last change {{.}}</span>{{end}}</div>
<details class="library-summary">
<summary><span>{{template "icon-layers"}} Library overview</span><span>{{.Count}} shortcut{{if ne .Count 1}}s{{end}} · {{.Actions}} action{{if ne .Actions 1}}s{{end}}</span></summary>
<div class="stats">
<div><strong>{{.Count}}</strong><span>Shortcuts</span></div>
<div><strong>{{.Actions}}</strong><span>Actions</span></div>
<div><strong>{{.Flagged}}{{if .Flagged}}<span class="warning-dot">{{template "icon-warning"}}</span>{{end}}</strong><span>Flagged</span></div>
</div>
</details>
<div class="library-toolbar" id="toolbar" hidden>
<label class="search">{{template "icon-search"}}<span class="sr-only">Search shortcuts</span><input id="search" type="search" placeholder="Search shortcuts" autocomplete="off" spellcheck="false"><kbd aria-hidden="true">/</kbd></label>
<select id="filter" aria-label="Filter shortcuts"><option value="all" data-label="All shortcuts">All shortcuts ({{.Count}})</option><option value="flagged" data-label="Flagged">Flagged ({{.Flagged}})</option></select>
<select id="sort" aria-label="Sort shortcuts"><option value="name">Sort by name</option><option value="actions">Most actions</option><option value="modified">Recently modified</option></select>
<div class="results-summary" role="status" aria-live="polite"><h2 id="results-title">All shortcuts</h2><span class="results-count" id="results-count">{{.Count}} shortcut{{if ne .Count 1}}s{{end}}</span></div>
</div>
<div class="cards" id="shortcuts">
{{- range .Rows}}
<a class="shortcut-card" href="{{.Href}}" data-actions="{{.ActionCount}}" data-modified="{{.ModifiedSort}}"{{if .Flagged}} data-flagged{{end}}>
<div class="card-top"><span class="shortcut-icon{{if .DarkIcon}} dark-icon{{end}}" style="--icon: {{.Color}}" title="{{.ColorText}}">{{template "icon-layers"}}</span>{{with .MinimumOS}}<span class="category">iOS {{.}}</span>{{end}}</div>
<h3>{{.Name}}</h3>
<div class="card-meta"><span>{{.ActionCount}} action{{if ne .ActionCount 1}}s{{end}}</span>{{with .ModifiedDate}}<span>Modified {{.}}</span>{{end}}</div>
{{- if .Flagged}}
<span class="card-warning">{{template "icon-warning"}} Flagged in the review</span>
{{- end}}
</a>
{{- end}}
</div>
<div class="empty" id="empty" hidden><h2>No shortcuts found</h2><p>Try a different search or filter.</p><button type="button" class="btn" id="clear">Clear search and filters</button></div>
</main>
</body>
</html>
{{end}}
