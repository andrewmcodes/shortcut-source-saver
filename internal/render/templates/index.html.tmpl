{{define "index"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<link rel="stylesheet" href="{{.Stylesheet}}">
<script>
{{- template "theme-boot"}}

document.addEventListener('DOMContentLoaded', function () {
	const list = document.getElementById('shortcuts');
	const cards = Array.from(list.children);
	const search = document.getElementById('search');
	const filter = document.getElementById('filter');
	const outputFilter = document.getElementById('output-filter');
	const outputInputs = Array.from(outputFilter.querySelectorAll('input'));
	const cardOutputs = new Map(cards.map(function (card) { return [card, JSON.parse(card.dataset.outputs)]; }));
	const sort = document.getElementById('sort');
	const deleted = document.getElementById('show-deleted');
	const empty = document.getElementById('empty');
	const title = document.getElementById('results-title');
	const count = document.getElementById('results-count');
	const name = function (card) { return card.querySelector('h3').textContent; };
	const plural = function (n) { return n + (n === 1 ? ' shortcut' : ' shortcuts'); };
	const orders = {
		name: function (a, b) { return cards.indexOf(a) - cards.indexOf(b); },
		actions: function (a, b) { return Number(b.dataset.actions) - Number(a.dataset.actions); },
		modified: function (a, b) { return b.dataset.modified.localeCompare(a.dataset.modified); }
	};

	function inScope(card, option) {
		const match = option.dataset.match;
		return (deleted.checked || !card.hasAttribute('data-deleted')) && (!match || card.matches(match));
	}

	function update() {
		const query = search.value.trim().toLowerCase();
		const selected = filter.selectedOptions[0];
		const outputs = outputInputs.filter(function (input) { return input.checked; }).map(function (input) { return input.value; });
		outputFilter.querySelector('summary').textContent = outputs.length ? 'Output types · ' + outputs.length : 'Output types';
		document.getElementById('clear-outputs').disabled = outputs.length === 0;
		list.classList.toggle('with-deleted', deleted.checked);
		let pool = 0;
		let shown = 0;
		for (const card of cards) {
			const inFilter = inScope(card, selected) && (!outputs.length || outputs.some(function (type) { return cardOutputs.get(card).includes(type); }));
			const visible = inFilter && name(card).toLowerCase().includes(query);
			if (inFilter) { pool++; }
			if (visible) { shown++; }
			card.hidden = !visible;
		}
		for (const option of filter.options) {
			option.textContent = option.dataset.label + ' (' + cards.filter(function (card) { return inScope(card, option); }).length + ')';
		}
		title.textContent = selected.dataset.label;
		count.textContent = query ? shown + ' of ' + plural(pool) : plural(shown);
		empty.hidden = shown > 0;
		list.hidden = shown === 0;
	}

	function reorder() {
		const sorted = cards.slice().sort(function (a, b) { return orders[sort.value](a, b) || orders.name(a, b); });
		for (const card of sorted) { list.appendChild(card); }
	}

	function storeDeleted() {
		try {
			if (deleted.checked) { localStorage.setItem('sss-show-deleted', '1'); } else { localStorage.removeItem('sss-show-deleted'); }
		} catch (error) {}
	}

	function writeHash() {
		const hash = filter.value === 'all' ? '' : '#' + filter.value;
		if (window.location.hash !== hash) { history.replaceState(null, '', hash || window.location.pathname + window.location.search); }
	}

	function fromHash() {
		const wanted = window.location.hash.slice(1);
		const option = Array.from(filter.options).find(function (item) { return item.value === wanted; });
		if (option) { filter.value = option.value; }
		if (filter.value === 'deleted') { deleted.checked = true; }
		update();
	}

	try { deleted.checked = localStorage.getItem('sss-show-deleted') === '1'; } catch (error) {}
	outputFilter.addEventListener('change', update);
	document.getElementById('clear-outputs').addEventListener('click', function () {
		for (const input of outputInputs) { input.checked = false; }
		update();
	});
	outputFilter.addEventListener('keydown', function (event) {
		if (event.key === 'Escape') { outputFilter.open = false; outputFilter.querySelector('summary').focus(); }
	});
	document.addEventListener('click', function (event) {
		if (!outputFilter.contains(event.target)) { outputFilter.open = false; }
	});
	search.addEventListener('input', update);
	filter.addEventListener('change', function () {
		if (filter.value === 'deleted') { deleted.checked = true; }
		writeHash();
		update();
	});
	deleted.addEventListener('change', function () {
		if (!deleted.checked && filter.value === 'deleted') { filter.value = 'all'; writeHash(); }
		storeDeleted();
		update();
	});
	sort.addEventListener('change', reorder);
	document.getElementById('clear').addEventListener('click', function () {
		search.value = '';
		for (const input of outputInputs) { input.checked = false; }
		filter.value = 'all';
		writeHash();
		update();
		search.focus();
	});
	document.addEventListener('keydown', function (event) {
		const typing = ['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName);
		if (event.key === '/' && !typing && !event.metaKey && !event.ctrlKey) {
			event.preventDefault();
			search.focus();
		}
	});
	window.addEventListener('hashchange', fromHash);
	window.addEventListener('pageshow', function () { reorder(); fromHash(); });
	document.getElementById('toolbar').hidden = false;
{{template "theme-script"}}
});
</script>
</head>
<body>
{{template "topbar" .Chrome}}
<main>
<div class="page-heading"><h1>My shortcuts</h1>{{with .LastModified}}<span class="badge">Last change {{.}}</span>{{end}}</div>
<details class="library-summary">
<summary><span>{{template "icon-layers"}} Library overview</span><span>{{.Count}} shortcut{{if ne .Count 1}}s{{end}}{{if .Deleted}} · {{.Deleted}} deleted{{end}} · {{.Actions}} action{{if ne .Actions 1}}s{{end}}</span></summary>
<div class="stats">
<div><strong>{{.Count}}</strong><span>Shortcuts</span></div>
<div><strong>{{.Actions}}</strong><span>Actions</span></div>
<div><strong>{{.Flagged}}{{if .Flagged}}<span class="warning-dot">{{template "icon-warning"}}</span>{{end}}</strong><span>Flagged</span></div>
<div><strong>{{.Connected}}</strong><span>Connected</span></div>
{{- if .Deleted}}
<div><strong>{{.Deleted}}</strong><span>Deleted</span></div>
{{- end}}
</div>
{{- if .Deleted}}
<p class="stats-note">Counts are for shortcuts still in your library; deleted shortcuts and sync-conflict copies are counted separately.</p>
{{- end}}
</details>
<div class="library-toolbar" id="toolbar" hidden>
<label class="search">{{template "icon-search"}}<span class="sr-only">Search shortcuts</span><input id="search" type="search" placeholder="Search shortcuts" autocomplete="off" spellcheck="false"><kbd aria-hidden="true">/</kbd></label>
<select id="filter" aria-label="Filter shortcuts"><option value="all" data-label="All shortcuts">All shortcuts ({{.Count}})</option><option value="flagged" data-label="Flagged" data-match="[data-flagged]">Flagged ({{.Flagged}})</option><option value="connected" data-label="Connected" data-match="[data-connected], .with-deleted [data-linked]">Connected ({{.Connected}})</option><option value="standalone" data-label="Standalone" data-match=":not([data-connected]):not(.with-deleted [data-linked])">Standalone ({{.Standalone}})</option><option value="missing" data-label="Missing references" data-match="[data-missing]">Missing references ({{.Missing}})</option>{{if .Deleted}}<option value="deleted" data-label="Deleted" data-match="[data-deleted]">Deleted ({{.Deleted}})</option>{{end}}</select>
<details class="output-filter" id="output-filter"><summary>Output types</summary><div class="output-options"><p>Matches any selected output type.</p><fieldset><legend class="sr-only">Declared output types</legend>{{range .OutputTypes}}<label><input type="checkbox" value="{{.}}" autocomplete="off"><span>{{.}}</span></label>{{end}}</fieldset><button type="button" id="clear-outputs">Clear output types</button></div></details>
<select id="sort" aria-label="Sort shortcuts"><option value="name">Sort by name</option><option value="actions">Most actions</option><option value="modified">Recently modified</option></select>
<label class="toggle"{{if not .Deleted}} hidden{{end}}><input type="checkbox" id="show-deleted" autocomplete="off"><span>Show deleted</span><span class="toggle-count">{{.Deleted}}</span></label>
<div class="results-summary" role="status" aria-live="polite"><h2 id="results-title">All shortcuts</h2><span class="results-count" id="results-count">{{.Count}} shortcut{{if ne .Count 1}}s{{end}}</span></div>
</div>
<div class="cards" id="shortcuts">
{{- range .Rows}}{{$row := .}}
<a class="shortcut-card{{if .Inactive}} inactive{{end}}" href="{{.Href}}" data-outputs="{{.Outputs}}" data-actions="{{.ActionCount}}" data-modified="{{.ModifiedSort}}"{{if .Flagged}} data-flagged{{end}}{{if .Connected}} data-connected{{end}}{{if .Linked}} data-linked{{end}}{{if .Missing}} data-missing{{end}}{{if .Inactive}} data-deleted{{end}}>
<div class="card-top"><span class="shortcut-icon{{if .DarkIcon}} dark-icon{{end}}" style="--icon: {{.Color}}" title="{{.ColorText}}">{{template "icon-layers"}}</span>{{if .Inactive}}<span class="deleted-badge">{{template "icon-trash"}} Deleted</span>{{else}}{{with .MinimumOS}}<span class="category">iOS {{.}}</span>{{end}}{{end}}</div>
<h3>{{.Name}}</h3>
{{- with .Inactive}}
<span class="card-status"><span class="card-status-label">Deleted · </span>{{.}}</span>
{{- end}}
<div class="card-meta"><span>{{.ActionCount}} action{{if ne .ActionCount 1}}s{{end}}</span>{{with .ModifiedDate}}<span>Modified {{.}}</span>{{end}}<span class="card-links">{{if .Calls}}{{template "icon-link"}} {{.Calls}} call{{if ne .Calls 1}}s{{end}}{{else if .Callers}}{{template "icon-graph"}} {{.Callers}} caller{{if ne .Callers 1}}s{{end}}{{else if not .DeletedLinks}}Standalone{{end}}{{with .DeletedLinks}}<span class="card-deleted-links">{{if or $row.Calls $row.Callers}}+{{.}} deleted{{else}}{{template "icon-trash"}} {{.}} deleted link{{if ne . 1}}s{{end}}{{end}}</span>{{end}}</span></div>
{{- if .Flagged}}
<span class="card-warning">{{template "icon-warning"}} Flagged in the review</span>
{{- end}}
{{- if .Missing}}
<span class="card-warning">{{template "icon-warning"}} {{.Missing}} missing reference{{if ne .Missing 1}}s{{end}}</span>
{{- end}}
</a>
{{- end}}
</div>
<div class="empty" id="empty" hidden><h2>No shortcuts found</h2><p>Try a different search or filter.</p><button type="button" class="btn" id="clear">Clear search and filters</button></div>
<div class="library-footer"><span>{{template "icon-link"}} Run Shortcut actions are matched by workflow identifier, then by name.</span><a class="text-link" href="{{.MapHref}}">Explore dependency map {{template "icon-graph"}}</a></div>
</main>
{{template "site-footer"}}
</body>
</html>
{{end}}
